  "account.search": {
   "path": "/clientarea/search/",
   "pathParams": [],
   "body": {
    "fields": [
     {
      "name": "query",
      "type": "string",
      "required": true,
      "description": "Search keyword (service domain, invoice number, ticket subject, ...)"
     }
    ]
   },
   "notes": "The search keyword goes in the request body as {\"query\": \"...\"}, not in the path."
  },
  "cart.order": {
   "notes": "The single entry point for placing an order. It accepts several items of any product type in one call — hosting, VPS, domains, SSL — so the per-product and per-domain order routes are not needed. Preview the price first with cart.quote, which takes the same payload and creates nothing."
  },
  "cart.quote": {
   "notes": "Price preview for a cart.order payload. Returns the subtotal, tax, discounts and recurring amounts without creating an order or an invoice."
  },
  "cart.orderProduct": {
   "notes": "Legacy single-product form. Use cart.order instead — it is the supported way to place an order and handles multiple items in one call.",
   "deprecated": true
  },
  "domains.order": {
   "notes": "Domains are ordered through cart.order together with any other item. This route remains for the standalone domain flow.",
   "deprecated": true
  },
  "certificates.order": {
   "notes": "Certificates are ordered through cart.order together with any other item. This route remains for the standalone certificate flow.",
   "deprecated": true
  },
  "security.addIpAccess": {
   "notes": "The first rule switches the account into whitelist mode: every address that is not listed is refused, including the one you are calling from. Add your own address before adding any other, and remove it last."
  },
  "vms.createSnapshot": {
   "notes": "The snapshot name is generated by the platform (A<unix-timestamp>); a name sent in the request is ignored. Read it back from vms.listSnapshots before deleting."
  },
  "support.createTicket": {
   "notes": "Returns the new ticket number as {\"ticket\": 690686} — the field is `ticket`, not `ticket_number`. Use it as the {number} path parameter of the other ticket calls."
  },
  "account.getDetails": {
   "notes": "The response now carries verify.phone (bool) and a phone block {status, verified_at}. status is one of verified | unverified | taken_by_other | missing. Note that the top-level update_required is about the profile (national id, address), not the phone."
  },
  "auth.login": {
   "notes": "The response now carries verify.phone (bool) and a phone block {status, verified_at}. status is one of verified | unverified | taken_by_other | missing. Note that the top-level update_required is about the profile (national id, address), not the phone."
  },
  "auth.loginSso": {
   "notes": "The response now carries verify.phone (bool) and a phone block {status, verified_at}. status is one of verified | unverified | taken_by_other | missing. Note that the top-level update_required is about the profile (national id, address), not the phone."
  },
  "auth.verifyLoginOtp": {
   "notes": "The response now carries verify.phone (bool) and a phone block {status, verified_at}. status is one of verified | unverified | taken_by_other | missing. Note that the top-level update_required is about the profile (national id, address), not the phone."
  },
  "auth.requestLoginOtp": {
   "notes": "via reports the delivery channel. It falls back to email when the account's phone number is already verified by a different account, so an OTP is never sent to a SIM the account holder may not control."
  },
  "account.updateDetails": {
   "notes": "Changing phonenumber clears the phone verification: phone.status returns to unverified and the old number is released for another account to claim."
  },
  "auth.signup": {
   "notes": "Rejects a duplicate phone number with phone_invalid, phone_already_verified or phone_already_used, so one number registers exactly one account."
  }
 },
 "add": [
  {
   "id": "phone.requestOtp",
   "group": "phone",
   "name": "requestOtp",
   "method": "POST",
   "path": "/phone/otp",
   "auth": true,
   "tag": "Clientarea",
   "summary": "Send a phone verification code",
   "description": "Send a one-time code over Zalo ZNS to prove the account owner holds the SIM. Omit phonenumber to verify the number already on the account. Accounts that have already verified a number are refused with already_verified — change the number through PUT /details first, which clears the previous verification.",
   "pathParams": [],
   "query": [],
   "body": {
    "fields": [
     {
      "name": "phonenumber",
      "type": "string",
      "required": false,
      "description": "Number to verify. Defaults to the one on the account.",
      "enum": null,
      "default": null,
      "example": "0987654321"
     }
    ]
   },
   "verified": "spec",
   "notes": "Delivery is ZNS only — there is no email fallback, because the point is to prove possession of the SIM. The code lasts 300 seconds, may be resent after 60 seconds, at most 3 times, and is destroyed after 5 wrong attempts."
  },
  {
   "id": "phone.verify",
   "group": "phone",
   "name": "verify",
   "method": "POST",
   "path": "/phone/verify",
   "auth": true,
   "tag": "Clientarea",
   "summary": "Confirm a phone verification code",
   "description": "Confirm the code sent by phone.requestOtp. On success the number is written to the profile when it changed, and ownership of it is claimed for this account. No new token is issued — the current session continues.",
   "pathParams": [],
   "query": [],
   "body": {
    "fields": [
     {
      "name": "otp",
      "type": "string",
      "required": true,
      "description": "Six-digit code",
      "enum": null,
      "default": null,
      "example": "123456"
     }
    ]
   },
   "verified": "spec",
   "notes": "Returns {success, phone:{status, verified_at}}. A phone belongs to exactly one account: claiming is guarded by a unique index, so a race loses cleanly with phone_already_verified."
  }
 ],
