 "add": [
  {
   "id": "domains.updateContacts",
   "group": "domains",
   "name": "updateContacts",
   "method": "PUT",
   "path": "/domain/{id}/contact",
   "auth": true,
   "tag": "Domains",
   "summary": "Update domain contact (WHOIS) information",
   "description": "Update the registrant, admin, tech and billing contacts of a domain.",
   "pathParams": [
    {
     "name": "id",
     "type": "string",
     "required": true,
     "description": "Domain id"
    }
   ],
   "body": {
    "fields": [
     {
      "name": "registrant",
      "type": "object",
      "required": false,
      "description": "Registrant contact fields"
     },
     {
      "name": "admin",
      "type": "object",
      "required": false,
      "description": "Administrative contact fields"
     },
     {
      "name": "tech",
      "type": "object",
      "required": false,
      "description": "Technical contact fields"
     },
     {
      "name": "billing",
      "type": "object",
      "required": false,
      "description": "Billing contact fields"
     }
    ]
   },
   "verified": "spec"
  }
